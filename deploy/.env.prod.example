# Copy to deploy/.env.prod on the server and fill in. Never commit the real file.
ERPNEXT_VERSION=v16.50.0
# Image built on the server from this repo by deploy/deploy.sh (tag = git commit)
CUSTOM_IMAGE=garage-erp
CUSTOM_TAG=latest
PULL_POLICY=never

# Strong random value, e.g.  openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=CHANGE_ME

# Public hostname (DNS A record -> VPS IP) and Let's Encrypt contact
SITES_RULE=Host(`erp.example.com`)
LETSENCRYPT_EMAIL=you@example.com

GUNICORN_WORKERS=2
GUNICORN_THREADS=4
CLIENT_MAX_BODY_SIZE=50m

# Site name = public hostname (used by backup/restore scripts)
SITE_NAME=erp.example.com
